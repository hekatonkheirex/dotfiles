{
  "layer": "top", 				// Waybar at top layer
  /* "mode": "dock", 				// Display mode (dock|hide|invisible|overlay) */
  "exclusive": true, 				// Request an exclusive zone from the compositor
  "passthrough": false, 			// Pass any pointer events to the window under the bar
  "position": "top", 			// Waybar position (top|bottom|left|right)
  "height": "", 					// Waybar height (to be removed for auto height)
  "width": "", 					// Waybar width (empty for auto width)
  "spacing": 0, 					// Gaps between modules
  "margin": 0, 					// Space around the bar
  "margin-top": 0, 				// Space above the bar
  "margin-bottom": 0, 			// Space below the bar
  "margin-left": 0, 				// Space to the left of the bar
  "margin-right": 0, 				// Space to the right of the bar
  "fixed-center": true, 			// Center modules position
  "gtk-layer-shell": true,
  /* "ipc": true, 					// Control waybar with `swaymsg bar` commands */
  "bar_id": "bar-0",

  // Choose the order of the modules
  "modules-left": ["image", "niri/workspaces", "niri/window"],
  "modules-center": [],
  "modules-right": ["idle_inhibitor", "custom/wall", "wireplumber", "backlight", "battery", "tray", "clock"],

  "niri/workspaces": {
    "format": "{icon}",
    "ignore-hidden": true,
    "on-click": "activate",
    "on-click-right": "deactivate",
    "sort-by-id": true
  },

  "niri/window": {
    "format": "{title}",
    "icon": true,
    "icon-size": 24,
  },

  "backlight": {
    "interval": 10,
    "format": "{icon} {percent}%",
    "format-icons": ["<span rise='-2000'>\ue1ae</span>"],
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
    "smooth-scrolling-threshold": 1,
    "tooltip": false,
  },

  "battery": {
		"interval": 60,
		"full-at": 100,
		"design-capacity": false,
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 20
    },
    "format": "{icon} {capacity}%",
    "format-charging": "<span rise='-2000'>\uf250</span> {capacity}%",
    "format-plugged": "<span rise='-2000'>\uf251</span> {capacity}%",
    "format-full": "<span rise='-2000'>\uf304</span> 100%",
    "format-icons": ["<span rise='-2000'>\uf30b</span>", "<span rise='-2000'>\uf30a</span>", "<span rise='-2000'>\uf309</span>", "<span rise='-2000'>\uf308</span>", "<span rise='-2000'>\uf307</span>"],
    "format-alt": "{time}",
    "format-time": "{H}h {M}min",
    "tooltip": true,
  },

  "clock": {
    "format": "{:%a %b %d %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "format": {
        "today": "<span color = '#f38ba8'><b><u>{}</u></b></span>",
      },
    },
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "\ue8f4",
      "deactivated": "\ue8f5"
    }
  },
  
  "network": {
    "interval": 10,
    //"interface": "wlan*", // (Optional) To force the use of this interface, set it for netspeed to work
    "format-wifi": "",
    "format-ethernet": "",
    "format-linked": "",
    "format-disconnected": "",
    "format-disabled": "",
    "tooltip-format": "{essid} :  {bandwidthUpBits} |  {bandwidthDownBits}",
    "on-click": "[[ ! `pidof nm-connection-editor` ]] && nm-connection-editor || pkill nm-connection-e",
  },

  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "<span rise='-2000'>\ue04f</span> Muted",
    "format-bluetooth": "<span rise='-2000'>\uf324</span> {volume}%",
    "format-source": "<span rise='-2000'>\ue029</span> {volume}%",
    "format-source-muted": "<span rise='-2000'>\ue02b</span> Muted",
    "format-icons": {
      "headphone": "<span rise='-2000'>\uf01f</span>",
      "hands-free": "<span rise='-2000'>\ue311</span>",
      "headset": "<span rise='-2000'>\ue311</span>",
      "phone": "<span rise='-2000'>\ue9cd</span>",
      "portable": "<span rise='-2000'>\ue7ba</span>",
      "default": ["<span rise='-2000'>\ue04e</span>", "<span rise='-2000'>\ue04d</span>", "<span rise='-2000'>\ue050</span>"]
    },
    "scroll-step": 5.0,
    "on-click": "pactl set-sink-mute 0 toggle",
    "on-click-right": "pavucontrol",
    "smooth-scrolling-threshold": 1,
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8,
  },

   "image": {
    "path": "/home/mura/.config/niri/waybar/images/niri.png",
    "size": 24,
    "on-click": "killall rofi || rofi -show drun",
    "tooltip": false,
    "interval": 60,
  },

  "temperature": {
    "format": "&#xeb38; {temperatureC}°C",
    "thermal-zone": 2,
    "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    "critical-threshold": 80,
    "format-critical": "{temperatureC}°C",
  },

  "cpu": {
    "interval": 60,
    "format": "&#xef8e; {}%",
    "max-length": 10
  },

  "memory": {
    "interval": 60,
    "format": "&#xf075; {}%",
    "max-length": 10
  },

  "disk": {
  	"interval": 60,
	  "format": "&#xf384; {free}",
	  "unit": "GB"
  },

  "custom/pacman": {
    "format": "&#xeaff; {}",
    "interval": 3600,
    "exec": "checkupdates | wc -l",
    "exec-if": "exit 0",
    "on-click": "kitty --hold sh -c 'paru'; pkill -SIGRTMIN+8 waybar",
    "signal": 8
  },

  "custom/wall": {
    "format": "\ue1bc",
    "on-click": "~/.local/bin/wall",
    "tooltip": false
  }
}
