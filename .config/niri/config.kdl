include "environments.kdl"
include "inputs.kdl"
include "outputs.kdl"
include "decorations.kdl"
include "startup.kdl"
include "windowrules.kdl"
include "keybinds.kdl"
include "colors.kdl"

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
  }

switch-events {
    lid-close { spawn "/home/mura/.config/quickshell/scripts/lock"; }
}

debug {
  honor-xdg-activation-with-invalid-serial
}
