// Generated dynamically by sync-terminal-theme.sh
layout {
    
    focus-ring {
        width 2
        active-color "#ffb599"
        inactive-color "#a48b83"
    }
    border {
        off
        width 2
        active-color "#ffb599"
        inactive-color "#a48b83"
        urgent-color "#ffb599"
    }
}
window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
}
