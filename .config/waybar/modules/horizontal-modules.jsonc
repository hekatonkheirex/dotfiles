{
  "hyprland/workspaces": {
    "disable-scroll": false,
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "format": "{icon}",
    "format-icons": {
			"urgent": "",
			"active": "",
			"default": "",
    "sort-by-number": true
    },
  },

  "hyprland/window": {
    "max-length": 50,
    "format": "{}",
    "rewrite": {
      "(.*) — Mozilla Firefox": "$1",
      "(.*) - Vivaldi": "$1",
      "(.*) - Thunar": "$1",
      "(.*) - Discord": "$1",
      // ": "Desktop",
      "~": "kitty",
      "n ": "neovim",
    },
    "separate-outputs": true
  },

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 18,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": [
      "kitty"
    ],
    "app_ids-mapping": {
      "firefoxdeveloperedition": "firefox-developer-edition"
    },
    "rewrite": {
      "New Tab": "Brave",
      "Foot Server": "Terminal"
    }
  },

  "backlight": {
    "interval": 10,
    "format": "{icon} {percent}%",
    "format-icons": ["&#xeb7f;"],
    "on-scroll-up": "light -A 5%",
    "on-scroll-down": "light -U 5%",
    "smooth-scrolling-threshold": 1,
    "tooltip": false,
  },

  "battery": {
		"interval": 60,
		"full-at": 100,
		"design-capacity": false,
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 20
    },
    "format": "{icon} {capacity}%",
    "format-charging": "&#xea33; {capacity}%",
    "format-plugged": "&#xef3b; {capacity}%",
    "format-full": "&#xf668; 100%",
    "format-icons": ["&#xea34;", "&#xea2f;", "&#xea30;", "&#xea31;", "&#xea32;"],
    "format-alt": "{time}",
    "format-time": "{H}h {M}min",
    "tooltip": true,
  },

  "clock": {
    "format": "&#xea70; {:%H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "format": {
        "today": "<span color = '#f38ba8'><b><u>{}</u></b></span>",
      },
    },
    "format-alt": "&#xea53; {:%Y-%m-%d}",
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "&#xef0e;",
      "deactivated": "&#xf106;"
    }
  },
  
  "network": {
    "interval": 10,
    //"interface": "wlan*", // (Optional) To force the use of this interface, set it for netspeed to work
    "format-wifi": "",
    "format-ethernet": "",
    "format-linked": "",
    "format-disconnected": "",
    "format-disabled": "",
    "tooltip-format": "{essid} :  {bandwidthUpBits} |  {bandwidthDownBits}",
    "on-click": "[[ ! `pidof nm-connection-editor` ]] && nm-connection-editor || pkill nm-connection-e",
  },

  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "&#xf1c3; Muted",
    "format-bluetooth": "&#xea37; {volume}%",
    "format-source": "&#xeaf0; {volume}%",
    "format-source-muted": "&#xed16; Muted",
    "format-icons": {
      "headphone": "&#xeabd;",
      "hands-free": "&#xf5a9;",
      "headset": "&#xeb90;",
      "phone": "&#xeb09;",
      "portable": "&#xea8a;",
      "default": ["&#xeb50;", "&#xeb4f;", "&#xeb51;"]
    },
    "scroll-step": 5.0,
    "on-click": "pactl set-sink-mute 0 toggle",
    "on-click-right": "pavucontrol",
    "smooth-scrolling-threshold": 1,
  },


  "tray": {
    "icon-size": 16,
    "spacing": 8,
  },

  "hyprland/language": {
    "format": "{}",
    "format-en": "US",
    "format-es": "ES",
    "tooltip": "false",
  },

  "image": {
    "path": "/home/mura/.config/waybar/images/hyprland.png",
    "size": 24,
    "on-click": "killall rofi || rofi -show drun",
    "tooltip": false,
  },

  "temperature": {
    "format": "&#xeb38; {temperatureC}°C",
    "thermal-zone": 2,
    "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    "critical-threshold": 80,
    "format-critical": "{temperatureC}°C",
  },

  "cpu": {
    "interval": 60,
    "format": "&#xef8e; {}%",
    "max-length": 10
  },

  "memory": {
    "interval": 60,
    "format": "&#xf075; {}%",
    "max-length": 10
  },

  "disk": {
  	"interval": 60,
	  "format": "&#xf384; {free}",
	  "unit": "GB"
  },

	"group/hardware": {
    "drawer": {
        "transition-duration": 500,
        "transition-left-to-right": false,
    },
		"orientation": "horizontal",
		"modules": [
			"cpu",
			"memory",
			"temperature",
      "disk"
		]
	},
}
