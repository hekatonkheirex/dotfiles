# Appearance
font-family = "Maple Mono NF"
font-size = 13
theme = Catppuccin Mocha

# Window Behavior (Ideal for Wayland Tiling WMs)
# Disables the GTK title bar so your compositor handles the borders
window-decoration = false
confirm-close-surface = false

# rendering performance
# "auto" is usually best, but you can force "vulkan" or "gl" if you see artifacts
gtk-single-instance = true

# Opacity / Transparency
# 1.0 is opaque, 0.0 is invisible.
background-opacity = 0.95
# Applies a blur to the transparent background (requires compositor support)
background-blur-radius = 20

# Shell Integration
# Ensures new tabs open in the same directory as the current one
working-directory = inherit

# Keybinds (Optional - Ghostty uses Crtl+Shift+... by default)
# keybind = ctrl+t=new_tab
# keybind = ctrl+w=close_surface

# Typography
# Enables standard ligatures (Contextual Alternates)
font-feature = "calt"
# You can also add specific features like "zero" for a slashed zero:
# font-feature = "zero"

# Window Padding (Internal "breathing room")
# Adjust these numbers to increase/decrease the space
window-padding-x = 10
window-padding-y = 10
# Ensures the padding color matches the background perfectly
window-padding-balance = true
