<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <action id="org.quickshell.sddm-theme">
    <description>Change the SDDM login theme</description>
    <message>Authentication is required to change the SDDM login theme.</message>
    <icon_name>preferences-desktop-theme</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/quickshell-sync-sddm-theme</annotate>
  </action>
</policyconfig>
