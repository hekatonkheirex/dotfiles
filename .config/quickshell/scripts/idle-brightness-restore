#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
  runtime_dir="$XDG_RUNTIME_DIR/quickshell"
else
  runtime_dir="$HOME/.cache/quickshell/runtime"
fi

state_file="$runtime_dir/previous-brightness"
if [[ ! -r "$state_file" ]]; then
  exit 0
fi

value=$(<"$state_file")
if [[ ! "$value" =~ ^[0-9]+%?$ ]]; then
  printf 'Ignoring invalid saved brightness value.\n' >&2
  rm -f -- "$state_file"
  exit 1
fi

brightnessctl set "$value"
rm -f -- "$state_file"
