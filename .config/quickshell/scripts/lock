#!/usr/bin/env bash

# Mango's Quickshell lock surface is a layer-shell overlay rather than a
# compositor session lock, so use swaylock directly for every script-based
# lock request there. This also makes swayidle wait until swaylock has locked
# the session before it proceeds to suspend.
quickshell_bin=$(command -v quickshell || true)
desktop_names="${XDG_CURRENT_DESKTOP:-} ${XDG_SESSION_DESKTOP:-}"
case "${desktop_names,,}" in
  *mango*)
    if [ -n "$quickshell_bin" ] \
      && "$quickshell_bin" list 2>/dev/null | rg -q 'Config path: .*/\.config/quickshell/shell\.qml'; then
      "$quickshell_bin" ipc call shell dismissPopups >/dev/null 2>&1 || true
    fi
    exec swaylock -f
    ;;
esac

# On Niri, read the current compositor-backed lock state from Quickshell.
# A marker from a previous shell process must never authorize suspend.
if [ -n "$quickshell_bin" ] \
  && /usr/bin/timeout --foreground 1s "$quickshell_bin" list 2>/dev/null | rg -q 'Config path: .*/\.config/quickshell/shell\.qml'; then
  if printf '%s' "$desktop_names" | rg -qi 'niri'; then
    if /usr/bin/timeout --foreground 1s "$quickshell_bin" ipc call shell lock >/dev/null 2>&1; then
      attempt=0
      while [ "$attempt" -lt 30 ]; do
        if [ "$(/usr/bin/timeout --foreground 1s "$quickshell_bin" ipc prop get shell lockSecure 2>/dev/null)" = "true" ]; then
          exit 0
        fi
        sleep 0.05
        attempt=$((attempt + 1))
      done
      printf 'Quickshell did not confirm a secure Niri session lock.\n' >&2
    fi
    exec swaylock -f
  fi

  exec "$(dirname -- "$0")/emit-trigger" qslock-trigger
fi

exec swaylock -f
