#!/usr/bin/env bash
set -euo pipefail

trigger="${1:-}"
case "$trigger" in
  qslauncher-trigger|qsquickmenu-trigger|qssettings-trigger|qscommandcenter-trigger|qslock-trigger|\
  qsosd-vol|qsosd-bright|qsosd-mic|qsosd-airplane|qsosd-bluetooth)
    ;;
  *)
    printf 'Unknown Quickshell trigger: %s\n' "$trigger" >&2
    exit 2
    ;;
esac

script_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=runtime-dir.sh
source "$script_dir/runtime-dir.sh"
runtime_dir=$(quickshell_runtime_dir)
ensure_quickshell_runtime_dir "$runtime_dir"
trigger_path="$runtime_dir/$trigger"
rm -f -- "$trigger_path"
: >"$trigger_path"
