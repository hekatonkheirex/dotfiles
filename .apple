# macOS Tahoe Liquid Glass (for zsh-syntax-highlighting)
#
# Source this in ~/.zshrc before activating zsh-syntax-highlighting:
#   source ~/.apple
ZSH_HIGHLIGHT_HIGHLIGHTERS=(main cursor)
typeset -gA ZSH_HIGHLIGHT_STYLES

# Main highlighter styling: https://github.com/zsh-users/zsh-syntax-highlighting/blob/master/docs/highlighters/main.md
#
## General
### Diffs
### Markup
## Classes
## Comments
ZSH_HIGHLIGHT_STYLES[comment]='fg=#484F58'
## Constants
## Entitites
## Functions/methods
ZSH_HIGHLIGHT_STYLES[alias]='fg=#79B757'
ZSH_HIGHLIGHT_STYLES[suffix-alias]='fg=#0088FF'
ZSH_HIGHLIGHT_STYLES[global-alias]='fg=#0088FF'
ZSH_HIGHLIGHT_STYLES[function]='fg=#0088FF'
ZSH_HIGHLIGHT_STYLES[command]='fg=#79B757'
ZSH_HIGHLIGHT_STYLES[precommand]='fg=#79B757,italic'
ZSH_HIGHLIGHT_STYLES[autodirectory]='fg=#E9873A,italic'
ZSH_HIGHLIGHT_STYLES[single-hyphen-option]='fg=#E9873A'
ZSH_HIGHLIGHT_STYLES[double-hyphen-option]='fg=#E9873A'
ZSH_HIGHLIGHT_STYLES[back-quoted-argument]='fg=#BC8CFF'
## Keywords
## Built ins
ZSH_HIGHLIGHT_STYLES[builtin]='fg=#79B757'
ZSH_HIGHLIGHT_STYLES[reserved-word]='fg=#FF6489'
ZSH_HIGHLIGHT_STYLES[hashed-command]='fg=#79B757'
## Punctuation
ZSH_HIGHLIGHT_STYLES[commandseparator]='fg=#FF6489'
ZSH_HIGHLIGHT_STYLES[command-substitution-delimiter]='fg=#C9D1D9'
ZSH_HIGHLIGHT_STYLES[command-substitution-delimiter-unquoted]='fg=#C9D1D9'
ZSH_HIGHLIGHT_STYLES[process-substitution-delimiter]='fg=#C9D1D9'
ZSH_HIGHLIGHT_STYLES[back-quoted-argument-delimiter]='fg=#FF6489'
ZSH_HIGHLIGHT_STYLES[back-double-quoted-argument]='fg=#FF6489'
ZSH_HIGHLIGHT_STYLES[back-dollar-quoted-argument]='fg=#FF6489'
## Serializable / Configuration Languages
## Storage
## Strings
ZSH_HIGHLIGHT_STYLES[command-substitution-quoted]='fg=#79B757'
ZSH_HIGHLIGHT_STYLES[command-substitution-delimiter-quoted]='fg=#79B757'
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=#79B757'
ZSH_HIGHLIGHT_STYLES[single-quoted-argument-unclosed]='fg=#ED5F5D'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=#79B757'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument-unclosed]='fg=#ED5F5D'
ZSH_HIGHLIGHT_STYLES[rc-quote]='fg=#79B757'
## Variables
ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument]='fg=#C9D1D9'
ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument-unclosed]='fg=#ED5F5D'
ZSH_HIGHLIGHT_STYLES[dollar-double-quoted-argument]='fg=#C9D1D9'
ZSH_HIGHLIGHT_STYLES[assign]='fg=#048ABF'
ZSH_HIGHLIGHT_STYLES[named-fd]='fg=#C9D1D9'
ZSH_HIGHLIGHT_STYLES[numeric-fd]='fg=#E9873A'
## No category relevant in spec
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#ED5F5D'
ZSH_HIGHLIGHT_STYLES[path]='fg=#C9D1D9,underline'
ZSH_HIGHLIGHT_STYLES[path_pathseparator]='fg=#FF6489,underline'
ZSH_HIGHLIGHT_STYLES[path_prefix]='fg=#C9D1D9,underline'
ZSH_HIGHLIGHT_STYLES[path_prefix_pathseparator]='fg=#FF6489,underline'
ZSH_HIGHLIGHT_STYLES[globbing]='fg=#C9D1D9'
ZSH_HIGHLIGHT_STYLES[history-expansion]='fg=#BC8CFF'
#ZSH_HIGHLIGHT_STYLES[command-substitution]='fg=?'
#ZSH_HIGHLIGHT_STYLES[command-substitution-unquoted]='fg=?'
#ZSH_HIGHLIGHT_STYLES[process-substitution]='fg=?'
#ZSH_HIGHLIGHT_STYLES[arithmetic-expansion]='fg=?'
ZSH_HIGHLIGHT_STYLES[back-quoted-argument-unclosed]='fg=#ED5F5D'
ZSH_HIGHLIGHT_STYLES[redirection]='fg=#048ABF'
ZSH_HIGHLIGHT_STYLES[arg0]='fg=#C9D1D9'
ZSH_HIGHLIGHT_STYLES[default]='fg=#C9D1D9'
ZSH_HIGHLIGHT_STYLES[cursor]='fg=#C9D1D9'
